@model IEnumerable<SecretSanta.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Create new event</a>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Budget</th>
            <th>Organizer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                <td>@item.Budget.ToString("0.00")</td>
                <td>@item.OrganizerName</td>
                <th>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </th>
            </tr>
        }
    </tbody>
</table>