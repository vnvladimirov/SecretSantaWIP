@model SecretSanta.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/event-forms.css" asp-append-version="true" />
}

<div class="santa-event-form-page">

        <h1 class="santa-form-title mt-2">Create your event</h1>

        <p class="santa-form-intro">
            Set up your Secret Santa gathering. You can add participants
            and manage the gift exchange once your event is created.
        </p>
    </header>

    <section class="card santa-event-form-card">

        <div class="santa-form-card-header">
            <div class="santa-form-header-icon" aria-hidden="true">
                <i class="bi bi-gift-fill"></i>
            </div>

            <div>
                <h2>Event details</h2>
                <p>Tell us about your gift exchange.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            <div class="santa-form-card-body">

                <div asp-validation-summary="ModelOnly" class="santa-validation-summary" role="alert"></div>

                <div class="santa-form-section-heading">
                    <i class="bi bi-calendar-heart" aria-hidden="true"></i>
                    <h3>About your event</h3>
                </div>

                <div class="santa-form-grid">

                    <div class="santa-form-field santa-form-field-wide">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                            Event name
                        </label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name" class="santa-field-validation"></span>
                    </div>

                    <div class="santa-form-field santa-form-field-wide">
                        <label asp-for="Description" class="form-label">
                            <i class="bi bi-card-text me-2" aria-hidden="true"></i>
                            Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="santa-field-validation"></span>
                    </div>

                    <div class="santa-form-field">
                        <label asp-for="EventDate" class="form-label">
                            <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>
                            Event date
                        </label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="santa-field-validation"></span>
                    </div>

                    <div class="santa-form-field">
                        <label asp-for="Budget" class="form-label">
                            <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>
                            Gift budget
                        </label>
                        <input asp-for="Budget" class="form-control" />
                        <span asp-validation-for="Budget" class="santa-field-validation"></span>
                    </div>

                    <div class="santa-form-field">
                        <label asp-for="MinParticipants" class="form-label">
                            <i class="bi bi-people me-2" aria-hidden="true"></i>
                            Minimum participants
                        </label>
                        <input asp-for="MinParticipants" class="form-control" />
                        <span asp-validation-for="MinParticipants" class="santa-field-validation"></span>
                    </div>

                </div>

                <div class="santa-form-section-heading santa-organizer-heading">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    <h3>Organizer information</h3>
                </div>

                <div class="santa-form-grid">

                    <div class="santa-form-field">
                        <label asp-for="OrganizerName" class="form-label">
                            <i class="bi bi-person me-2" aria-hidden="true"></i>
                            Organizer name
                        </label>
                        <input asp-for="OrganizerName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="OrganizerName" class="santa-field-validation"></span>
                    </div>

                    <div class="santa-form-field">
                        <label asp-for="OrganizerEmail" class="form-label">
                            <i class="bi bi-envelope me-2" aria-hidden="true"></i>
                            Organizer email
                        </label>
                        <input asp-for="OrganizerEmail" class="form-control" autocomplete="email" />
                        <span asp-validation-for="OrganizerEmail" class="santa-field-validation"></span>
                    </div>

                </div>

            </div>

            <div class="santa-form-card-footer">
                <a asp-action="Index" class="btn btn-outline-success santa-form-back-button">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                    Back to events
                </a>

                <button type="submit" class="btn btn-success santa-form-submit-button">
                    <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
                    Create event
                </button>
            </div>
        </form>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
