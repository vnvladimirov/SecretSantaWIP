@model SecretSanta.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Name</h1>

<dl class="row">
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.EventDate.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-2">Budget</dt>
    <dd class="col-sm-10">@Model.Budget.ToString("0.00")</dd>

    <dt class="col-sm-2">Minimum participants</dt>
    <dd class="col-sm-10">@Model.MinParticipants</dd>

    <dt class="col-sm-2">Organizer</dt>
    <dd class="col-sm-10">@Model.OrganizerName</dd>
    
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.OrganizerEmail</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to list</a>