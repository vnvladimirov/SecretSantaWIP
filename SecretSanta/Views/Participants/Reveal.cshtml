@model SecretSanta.Models.ViewModels.RevealViewModel

@{
    ViewData["Title"] = "Secret Santa assignment";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 text-center">
                <div class="card-body p-4 p-md-5">
                    <span class="santa-eyebrow">
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        SECRET ASSIGNMENT
                    </span>

                    <h1 class="h3 mt-3">@Model.ParticipantName</h1>

                    @if (Model.ReceiverName != null)
                    {
                        <p class="text-muted mb-1">
                            In <strong>@Model.EventName</strong>, @Model.ParticipantName is the Secret Santa for:
                        </p>
                        <p class="display-6 fw-bold mb-4">@Model.ReceiverName</p>
                    }
                    else
                    {
                        <p class="text-muted mb-4">
                            The draw for <strong>@Model.EventName</strong> hasn't been made yet,
                            or @Model.ParticipantName isn't part of the latest draw.
                        </p>
                    }

                    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId"
                       class="btn btn-outline-success">
                        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                        Back to event
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
