@model string

@{
    ViewData["Title"] = "Join Secret Santa";
}

<h1>Join Secret Santa</h1>

<h2>Hello, @ViewBag.ParticipantName!</h2>
<p>You've been invited to participate in <strong>@ViewBag.EventName</strong>.</p>

<form asp-controller="ParticipantAccess" asp-action="EnterPost" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" value="@Model" />
    <button type="submit">Continue</button>
</form>
