@model IEnumerable<SecretSanta.Models.WishlistItem>
@using SecretSanta.Models

@{
    ViewData["Title"] = "Wishlist";
    var participant = ViewBag.Participant as Participant;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">
                <i class="bi bi-gift"></i> Wishlist
            </h1>
            <p class="text-muted mb-0">
                Gift ideas for @(participant?.Name ?? "this participant")
            </p>
        </div>

        <a asp-action="Create" asp-route-participantId="@participant?.Id" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add gift idea
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="h5">Your wishlist is empty</h3>
                <p class="text-muted">
                    Add some gift ideas to help your Secret Santa.
                </p>
                <a asp-action="Create" asp-route-participantId="@participant?.Id" class="btn btn-success">
                    Add your first gift idea
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h2 class="h5 card-title">@item.Title</h2>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <p class="card-text text-muted">
                                    @item.Description
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.ProductUrl))
                            {
                                <a href="@item.ProductUrl" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-outline-primary btn-sm">
                                    View gift link
                                </a>
                            }
                        </div>

                        <div class="card-footer bg-white border-0 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
